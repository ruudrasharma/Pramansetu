.env
.env.local
.env.*.local

# ─── OS / Editor ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/

# ─── Testing ─────────────────────────────────────────────────────────────────
# Playwright output
playwright-report/
test-results/

# ─── Misc ────────────────────────────────────────────────────────────────────
*.zip
task.md         # internal build tracker, not project source
