# ── Chain / RPC ──────────────────────────────────────────────
NEXT_PUBLIC_CHAIN_ID=11155111                     # Ethereum Sepolia
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://rpc2.sepolia.org
DEPLOYER_PRIVATE_KEY=                            # NEVER commit — deployer wallet for Hardhat scripts
ALCHEMY_API_KEY=
ETHERSCAN_API_KEY=                               # for contract verification (Etherscan Sepolia)
# AMOY_RPC_URL=                                  # Deprecated: Amoy is no longer the target

# ── Deployed Contract Addresses ────────────────────────────────
NEXT_PUBLIC_DID_REGISTRY_ADDRESS=
NEXT_PUBLIC_CREDENTIAL_REGISTRY_ADDRESS=
NEXT_PUBLIC_ACCESS_CONTROL_ADDRESS=
NEXT_PUBLIC_ASSET_REGISTRY_ADDRESS=
NEXT_PUBLIC_GUARDIAN_RECOVERY_ADDRESS=
NEXT_PUBLIC_GOVERNANCE_TIMELOCK_ADDRESS=

# ── WalletConnect / wagmi ──────────────────────────────────────
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ── IPFS / Pinata ────────────────────────────────────────────────
PINATA_API_KEY=
PINATA_SECRET_API_KEY=
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# ── Subgraph / Indexer ───────────────────────────────────────────
NEXT_PUBLIC_SUBGRAPH_URL=https://api.thegraph.com/subgraphs/name/bel-chain/idam
GRAPH_DEPLOY_KEY=

# ── Anomaly Detection Service ─────────────────────────────────────
ANOMALY_SERVICE_URL=http://localhost:8090
ANOMALY_SERVICE_API_KEY=

# ── App ────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_ENV=development

# ── Data source ──────────────────────────────────────────────────────
# "mock" (default) — every lib/services/* hook reads/writes the in-memory fixture store,
# no wallet or deployed contracts required. "onchain" — hooks delegate to lib/hooks/* wagmi
# calls against the addresses above. See lib/services/dataMode.ts.
NEXT_PUBLIC_DATA_MODE=mock
